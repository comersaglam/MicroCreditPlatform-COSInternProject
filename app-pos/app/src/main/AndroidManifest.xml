<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed from this phase on: the app talks to the backend. Nothing calls out yet
         (writes still land in Room only), but the network stack is now wired in. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Apppos">
        <!-- Single Activity: every screen is a Fragment in nav_graph.xml -->
        <!-- singleTask: one instance only. The payment app opens app-pos in a new
             task (FLAG_ACTIVITY_NEW_TASK); without singleTask a stale second copy
             could linger and mis-route back to the payment app. With it, every
             launch reuses the one instance via onNewIntent, where the handoff flag
             is re-evaluated from the launching intent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Apppos"
            android:windowSoftInputMode="adjustResize">
            <!-- Standalone: own launcher icon, opens on the dashboard. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Veresiye handoff: the payment app (mock-pos) opens app-pos with
                 this action + an amount extra. exported=true (above) lets another
                 app target it. -->
            <intent-filter>
                <action android:name="com.example.app_pos.action.CREDIT" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Removes WorkManager's own on-startup initializer.

          WorkManager initialises itself through androidx.startup unless told otherwise, and
          that default instance is built BEFORE App.onCreate — with the stock worker factory,
          which cannot construct an @HiltWorker (it has injected constructor parameters).
          The result is a runtime "could not instantiate SyncWorker", not a build error.

          With the initializer removed, WorkManager instead reads App's Configuration.Provider
          on first use, which supplies Hilt's factory. This node="remove" IS the wiring — it is
          not an optimisation.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>