<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed from this phase on: the app talks to the backend. Nothing calls out yet
         (writes still land in Room only), but the network stack is now wired in. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 11+ package visibility. Without this, resolving the payment gateway fails
      silently: startActivity throws ActivityNotFoundException even though the gateway IS
      installed, because this app is not allowed to see it. We declare exactly what we
      launch and nothing else.
    -->
    <queries>
        <package android:name="com.tokeninc.sardis.paymentgateway" />
    </queries>

    <!-- allowBackup is OFF, and that is load-bearing (Turn 40c). Android backs the app's
         data up on uninstall and RESTORES it on the next install, so `adb uninstall` did
         not actually reset the device: three rounds of testing ran against rows from a
         seed deleted back in Turn 39. The giveaway was `t4` holding u_owner/c2 locally
         and u_market/m1 on the server: one id, two different rows, which no pull could
         have produced.

         Backing this database up is wrong on its own terms anyway: the server owns the
         data now, a reinstall re-pulls it, and a restored copy can only be a stale fork.
         dataExtractionRules/backup_rules are inert while this is false; they are kept so
         the intent stays visible if backup is ever revisited. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Apppos">
        <!-- Single Activity: every screen is a Fragment in nav_graph.xml -->
        <!--
          singleTop, NOT singleTask. The payment gateway now launches this for a RESULT: it
          has to know whether the customer approved the veresiye before deciding to print,
          and a singleTask launch runs in its own task, which Android answers with an
          immediate RESULT_CANCELED. Every refused and every accepted sale would have looked
          identical to the gateway.

          singleTop keeps what singleTask was here for — one instance, relaunches arriving
          through onNewIntent where the handoff flag is re-evaluated — while allowing the
          activity to sit in the caller's task and return a result to it.

          taskAffinity="" keeps a standalone launcher tap in a task of its own, so opening
          the app directly does not adopt whatever task happened to start it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Apppos"
            android:windowSoftInputMode="adjustResize">
            <!-- Standalone: own launcher icon, opens on the dashboard. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Veresiye handoff: the payment app (mock-pos) opens app-pos with
                 this action + an amount extra. exported=true (above) lets another
                 app target it. -->
            <intent-filter>
                <action android:name="com.example.app_pos.action.CREDIT" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Removes WorkManager's own on-startup initializer.

          WorkManager initialises itself through androidx.startup unless told otherwise, and
          that default instance is built BEFORE App.onCreate — with the stock worker factory,
          which cannot construct an @HiltWorker (it has injected constructor parameters).
          The result is a runtime "could not instantiate SyncWorker", not a build error.

          With the initializer removed, WorkManager instead reads App's Configuration.Provider
          on first use, which supplies Hilt's factory. This node="remove" IS the wiring — it is
          not an optimisation.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>