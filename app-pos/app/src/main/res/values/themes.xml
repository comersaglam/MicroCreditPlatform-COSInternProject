<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      A fixed dark theme (not DayNight): the palette is designed for dark only,
      and a POS terminal should look the same on every device and time of day.

      The action bar is kept so Navigation can drive the screen title and the
      up arrow via setupActionBarWithNavController.
    -->
    <style name="Theme.Apppos" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_background</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <!--
          Tonal buttons (the mocked payment methods) paint themselves with
          colorSecondaryContainer. Leaving it unset is what kept them on
          Material 3's default purple while the rest of the screen was already
          on-palette.
        -->
        <item name="colorSecondaryContainer">@color/surface_elevated</item>
        <item name="colorOnSecondaryContainer">@color/on_background</item>

        <!-- Same story for the tertiary roles, unused today but on-palette
             if a component ever reaches for them. -->
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/primary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_background</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_primary</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_background</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/on_background</item>
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <item name="colorSurfaceContainerLowest">@color/background</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/surface_elevated</item>

        <!-- Ripples and pressed states pick this up; the default is a purple
             tint that shows on every tap. -->
        <item name="colorControlHighlight">@color/primary_container</item>

        <item name="colorOutline">@color/outline</item>

        <!-- The type scale (Tur 44), bound so a plain TextView inherits it. -->
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Fides.Display</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Fides.Title</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Fides.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Fides.Caption</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Fides.Label</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Fides.Button</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!--
          The action bar defaults to a raised surface tint, which on this
          palette reads as a lighter grey band. Flatten it onto the background
          so the top of every screen is one continuous colour.
        -->
        <item name="actionBarTheme">@style/ThemeOverlay.Apppos.ActionBar</item>
        <item name="toolbarStyle">@style/Widget.Fides.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.Apppos.BottomNav</item>
    </style>

    <style name="ThemeOverlay.Apppos.ActionBar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/on_background</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!--
      Tabs: the active one is picked out in brand blue, the rest stay muted so
      the current section is readable at a glance from arm's length.
    -->
    <style name="Widget.Apppos.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">
            @style/Widget.Apppos.BottomNav.ActiveIndicator
        </item>
    </style>

    <style name="Widget.Apppos.BottomNav.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
    </style>


    <!--
      The action bar's inner Toolbar, with its content insets zeroed.

      Toolbar lays its children out as [navigation] [logo] [title] [custom view] [menu],
      and hands the custom view whatever is LEFT once the up arrow has taken its space. A
      view declared match_parent therefore fills a narrowed box, and anything centred in it
      centres on that box rather than on the bar: measured on the device the wordmark sat
      44px left of centre on a screen with no up arrow at all, and further off once one
      appeared.

      Zeroing the insets gives the custom view the full width, so its own gravity finds the
      real middle. Safe here because the title is switched off (see MainActivity) — the
      inset exists to keep a title clear of the navigation button, and there is no title.
    -->
    <style name="Widget.Fides.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="contentInsetStart">0dp</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="contentInsetEnd">0dp</item>
    </style>

</resources>
