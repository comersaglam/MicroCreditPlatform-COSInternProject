    <!-- Transaction detail: what one ledger entry was made of. Copied from app-mobile;
         the same screen serves both sides of the counter, so the words match. -->
    <string name="transaction_detail_title">İşlem detayı</string>
    <string name="basket_section_label">SEPET</string>
    <string name="basket_total_label">Sepet toplamı</string>
    <!-- Not phrased as a failure. A money-only handoff, a payment and a server-written
         indexation row all legitimately have nothing to itemise, and those are most of a
         normal history — an error tone here would call half of it broken. -->
    <string name="basket_empty">Bu işlemde sepet bilgisi yok.\nÜrün ayrıntısı olmadan, yalnız tutar devredilmiş.</string>
    <!-- "2 × 15,00 TL" / "2 × 15,00 TL · KDV %18". Two forms rather than one with an
         empty tail, so a zero-rated line does not trail a stray separator. -->
    <string name="basket_line_pricing">%1$s × %2$s</string>
    <string name="basket_line_pricing_tax">%1$s × %2$s · KDV %%%3$s</string>
    <!--
      Two lines, and the second one is the point. "It was worth 12,17 dollars then" alone
      invites the wrong reading — that the debt shrank. What actually happened is that the
      lira did: the same dollars now cost 586,78 TL, so the shopkeeper who waited a year to
      be paid is down 86,78 without anyone defaulting on anything. That is the argument the
      whole product rests on, and it belongs in the currency the reader thinks in.
    -->
    <string name="tx_detail_fx">Alındığı gün %1$s USD ediyordu</string>
    <string name="tx_detail_fx_equivalent">Bugünkü kurla %1$s</string>
</resources>
