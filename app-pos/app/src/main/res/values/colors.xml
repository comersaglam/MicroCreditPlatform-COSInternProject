<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Dark fintech palette. Trust reads as blue, positive money as green,
      debt as red. Backgrounds avoid pure black and text avoids pure white so
      the screen stays readable during a long shift at the till.
    -->
    <color name="background">#121212</color>
    <color name="surface">#1C1C1E</color>
    <color name="surface_elevated">#242428</color>
    <color name="primary">#4C8BFF</color>
    <color name="primary_container">#1A3A6B</color>
    <color name="accent">#00C896</color>
    <color name="error">#FF5C5C</color>
    <color name="on_background">#E4E4E7</color>
    <color name="on_surface_variant">#9B9BA1</color>
    <color name="outline">#2C2C2E</color>

    <!-- Container tones: the dimmed backdrop versions of the accent colours,
         used behind buttons and chips rather than for text. -->
    <color name="error_container">#5C1F1F</color>

    <color name="on_primary">#FFFFFF</color>
    <color name="on_accent">#00120C</color>

    <!-- Ledger semantics, mapped onto the palette above -->
    <color name="balance_due">@color/error</color>
    <color name="balance_clear">@color/on_surface_variant</color>
    <color name="payment_received">@color/accent</color>

    <!--
      Indexation: the month's inflation added to an outstanding balance. It moves the
      balance the same way a debt does, so it stays on the red side of the palette rather
      than earning a colour of its own.

      Muted, because no goods changed hands and no money moved. Kept identical to
      app-mobile's, so the same row reads the same on the counter and in the customer's
      hand.
    -->
    <color name="balance_indexation">#C77A7A</color>

</resources>
