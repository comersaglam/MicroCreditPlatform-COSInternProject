<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-level screen map.

  loginFragment     — the login gate. This is the START destination: a standalone
                      launch (launcher icon) lands here, and only a signed-in
                      merchant is sent on to the dashboard.
  dashboardFragment — the merchant's management view (bottom nav, see
                      dashboard_graph.xml). Reached after login.
  saleFlow          — the veresiye (credit) step of a sale. Entered from the
                      payment app (mock-pos) via the CREDIT Intent; MainActivity
                      navigates here after loading the amount, bypassing the gate
                      (the terminal is the merchant's; a live checkout is not blocked).

  A nested graph is also a ViewModel scope: SaleViewModel obtained with
  navGraphViewModels(saleFlow) is shared by the sale screens and destroyed when
  the flow is left, so each new sale starts clean.

  Android Studio renders this file visually (Design tab).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!--
      One flow, two transaction types (see SaleViewModel.txType):
        DEBT    — entered at customerSelect (amount handed over by the payment app)
        PAYMENT — entered at keypadFragment (amount keyed in; customer already known,
                  reached via the global action from a customer's detail screen)
      Both converge on confirm → otp → write.
    -->
    <!--
      keypadFragment is the START destination so BOTH entries land on a legal,
      directly-reachable node (a nested graph can only be entered at its start):
        PAYMENT — enter with amountMinor=0 + a customer; the keypad is shown so the
                  amount can be keyed in.
        DEBT    — enter with amountMinor>0 (from the payment app); the keypad sees a
                  ready amount and forwards straight to customerSelect.
    -->
    <navigation
        android:id="@+id/saleFlow"
        app:startDestination="@id/keypadFragment">

        <!-- Amount entry (PAYMENT) or pass-through (DEBT). Args seed the flow. -->
        <fragment
            android:id="@+id/keypadFragment"
            android:name="com.example.app_pos.ui.sale.KeypadFragment"
            android:label="@string/keypad_title"
            tools:layout="@layout/fragment_keypad">

            <argument android:name="amountMinor" app:argType="long" android:defaultValue="0L" />
            <argument android:name="payCustomerId" app:argType="string" android:defaultValue="" />
            <argument android:name="payCustomerName" app:argType="string" android:defaultValue="" />
            <argument android:name="payCustomerPhone" app:argType="string" android:defaultValue="" />
            <!--
              The gateway's basket, as the raw JSON it arrived in. It travels beside the
              amount rather than in place of it: the amount is what every screen of the
              flow works with, and the basket is only needed again at the write step.

              A nav argument rather than a field on the Activity, because SaleViewModel is
              scoped to this nested graph and the Activity cannot reach it — and because an
              argument survives process death, which a field would not.
            -->
            <argument android:name="orderBody" app:argType="string" android:defaultValue="" />

            <action
                android:id="@+id/action_keypad_to_confirm"
                app:destination="@id/confirmFragment" />
            <!-- DEBT: amount already handed over, so skip the keypad. -->
            <action
                android:id="@+id/action_keypad_to_customerSelect"
                app:destination="@id/customerSelectFragment"
                app:popUpTo="@id/keypadFragment"
                app:popUpToInclusive="true" />
        </fragment>

        <fragment
            android:id="@+id/customerSelectFragment"
            android:name="com.example.app_pos.ui.sale.CustomerSelectFragment"
            android:label="@string/customer_select_title"
            tools:layout="@layout/fragment_customer_select">

            <!-- Existing customer picked -> straight to confirm. -->
            <action
                android:id="@+id/action_customerSelect_to_confirm"
                app:destination="@id/confirmFragment" />
            <!-- New customer -> capture name + phone first. -->
            <action
                android:id="@+id/action_customerSelect_to_phone"
                app:destination="@id/phoneFragment" />
        </fragment>

        <!-- New-customer name + phone. -->
        <fragment
            android:id="@+id/phoneFragment"
            android:name="com.example.app_pos.ui.sale.PhoneFragment"
            android:label="@string/phone_title"
            tools:layout="@layout/fragment_phone">

            <argument
                android:name="initialName"
                android:defaultValue=""
                app:argType="string" />

            <action
                android:id="@+id/action_phone_to_confirm"
                app:destination="@id/confirmFragment" />
        </fragment>

        <!-- Summary; sends the entry for OTP approval (no write here). -->
        <fragment
            android:id="@+id/confirmFragment"
            android:name="com.example.app_pos.ui.sale.ConfirmFragment"
            android:label="@string/confirm_title"
            tools:layout="@layout/fragment_confirm">

            <action
                android:id="@+id/action_confirm_to_otp"
                app:destination="@id/otpFragment" />
        </fragment>

        <!-- Customer approval; writes the entry only on success. -->
        <fragment
            android:id="@+id/otpFragment"
            android:name="com.example.app_pos.ui.sale.OtpFragment"
            android:label="@string/otp_title"
            tools:layout="@layout/fragment_otp" />
    </navigation>

    <!--
      Login gate. This is the app's start destination (see the navigation's
      startDestination above): a standalone launch lands here, and only a signed-in
      merchant is sent on to the dashboard. Being the start destination, it shows no
      up-arrow. A CREDIT handoff bypasses the gate — MainActivity navigates straight
      to saleFlow on top of this — because the POS terminal is physically the
      merchant's and a live checkout must not be blocked.
    -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.app_pos.ui.login.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login" />

    <!-- Reached from the action bar; hosts its own bottom-nav graph -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.app_pos.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_title"
        tools:layout="@layout/fragment_dashboard" />

    <!-- Global action: reachable from any destination in the graph -->
    <action
        android:id="@+id/action_global_dashboard"
        app:destination="@id/dashboardFragment" />

    <!--
      PAYMENT entry point: a customer's detail screen opens the sale flow (which
      starts at the keypad) with the customer already chosen. Targets saleFlow —
      the graph, not an inner node — because only the start is reachable from
      outside; the keypad IS the start, so it shows. Args are forwarded to it.
    -->
    <action
        android:id="@+id/action_global_pay"
        app:destination="@id/saleFlow" />

    <!--
      After login: go to the dashboard AND pop the login gate off the stack
      (popUpToInclusive), so Back from the dashboard exits the app instead of
      returning to login. Kept separate from action_global_dashboard, which is used
      mid-sale to jump to the dashboard WITHOUT tearing the stack down.
    -->
    <action
        android:id="@+id/action_global_dashboard_after_login"
        app:destination="@id/dashboardFragment"
        app:popUpTo="@id/loginFragment"
        app:popUpToInclusive="true" />

    <!--
      Logout: return to the gate and clear everything above it (pop the whole graph
      inclusive), so the dashboard and its inner state are gone and Back from login
      exits the app.
    -->
    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <!--
      After a login that was triggered by a CREDIT handoff: resume the sale flow with
      the pending amount AND pop the login gate (so Back does not return to login).
      isCreditHandoff is still set, so the flow finishes back to the payment app.
    -->
    <action
        android:id="@+id/action_global_saleflow_after_login"
        app:destination="@id/saleFlow"
        app:popUpTo="@id/loginFragment"
        app:popUpToInclusive="true" />

</navigation>
