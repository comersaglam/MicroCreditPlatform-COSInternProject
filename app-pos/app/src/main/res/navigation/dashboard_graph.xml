<?xml version="1.0" encoding="utf-8"?>
<!--
  The dashboard's own graph, hosted inside DashboardFragment.

  The three top-level destination ids match the item ids in bottom_nav_menu.xml,
  which is how setupWithNavController connects a tab tap to a destination.
  Customer detail is part of this graph but has no tab: it is pushed on top of
  the Customers tab.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_graph"
    app:startDestination="@id/customersFragment">

    <fragment
        android:id="@+id/customersFragment"
        android:name="com.example.app_pos.ui.dashboard.customers.CustomersFragment"
        android:label="@string/nav_customers"
        tools:layout="@layout/fragment_customers">

        <action
            android:id="@+id/action_customers_to_customerDetail"
            app:destination="@id/customerDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/customerDetailFragment"
        android:name="com.example.app_pos.ui.dashboard.detail.CustomerDetailFragment"
        android:label="@string/customer_detail_title"
        tools:layout="@layout/fragment_customer_detail">

        <argument
            android:name="customerId"
            app:argType="string" />

        <argument
            android:name="customerName"
            app:argType="string" />

        <!-- Tapping a ledger row opens what was in it. Pushed on top of the customer's
             history, so Back returns to the same scroll position. -->
        <action
            android:id="@+id/action_customerDetail_to_transactionDetail"
            app:destination="@id/transactionDetailFragment" />
    </fragment>

    <!--
      One entry's basket. Reached only from a row tap; it has no tab and no other caller.

      The argument is the entry's id alone: the basket is on disk beside it, so passing
      the lines through the Bundle would serialise something the screen can simply read.
    -->
    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.example.app_pos.ui.dashboard.detail.TransactionDetailFragment"
        android:label="@string/transaction_detail_title"
        tools:layout="@layout/fragment_transaction_detail">

        <argument
            android:name="transactionId"
            app:argType="string" />
    </fragment>

    <!-- What is waiting on this shop's answer. Filled by a poll, not by anything this
         device writes: the cards are raised on the customer's phone. -->
    <fragment
        android:id="@+id/approvalsFragment"
        android:name="com.example.app_pos.ui.dashboard.approvals.ApprovalsFragment"
        android:label="@string/nav_approvals"
        tools:layout="@layout/fragment_approvals" />

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.example.app_pos.ui.dashboard.reports.ReportsFragment"
        android:label="@string/nav_reports"
        tools:layout="@layout/fragment_reports" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.app_pos.ui.dashboard.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile">

        <!-- Pairing pushed on top of Profile (like customer detail on Customers);
             the dashboard's inner Back returns here. -->
        <action
            android:id="@+id/action_profile_to_pairing"
            app:destination="@id/pairingFragment" />
    </fragment>

    <fragment
        android:id="@+id/pairingFragment"
        android:name="com.example.app_pos.ui.dashboard.profile.PairingFragment"
        android:label="@string/pairing_title"
        tools:layout="@layout/fragment_pairing" />

</navigation>
