<?xml version="1.0" encoding="utf-8"?>
<!-- Pill behind a section label: a lifted surface with a hairline outline, so the
     heading reads as a chip over the list rather than as another card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_elevated" />
    <stroke
        android:width="1dp"
        android:color="@color/outline" />
    <corners android:radius="8dp" />
</shape>
