<?xml version="1.0" encoding="utf-8"?>
<!--
  Final step of a sale: confirm the veresiye (credit) entry before it is written.

  Money is involved, so nothing is written until the merchant confirms here. The
  screen restates who, how much, and what the balance becomes — a wrong keypad
  entry should be caught at this glance, not after it lands in the ledger.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/space_5">

    <TextView
        android:id="@+id/confirmCustomerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/confirm_customer"
        android:textAppearance="@style/TextAppearance.Fides.Caption"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/confirmCustomerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:textColor="?attr/colorOnSurface"
        android:textAppearance="@style/TextAppearance.Fides.Title"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirmCustomerLabel"
        tools:text="Ahmet Yılmaz" />

    <!-- The amount being written: the one number that must be unmistakable -->
    <TextView
        android:id="@+id/confirmAmountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:textAppearance="@style/TextAppearance.Fides.Caption"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirmCustomerName"
        tools:text="@string/confirm_amount_debt" />

    <TextView
        android:id="@+id/confirmAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:textColor="@color/balance_due"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirmAmountLabel"
        tools:text="50,00 TL" />

    <!-- Before / after balance, so the effect of the entry is explicit -->
    <TextView
        android:id="@+id/confirmCurrentBalanceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/confirm_current_balance"
        android:textAppearance="@style/TextAppearance.Fides.Caption"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirmAmount" />

    <TextView
        android:id="@+id/confirmCurrentBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintBaseline_toBaselineOf="@id/confirmCurrentBalanceLabel"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="40,00 TL" />

    <TextView
        android:id="@+id/confirmNewBalanceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/confirm_new_balance"
        android:textColor="?attr/colorOnSurface"
        android:textAppearance="@style/TextAppearance.Fides.Money"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirmCurrentBalanceLabel" />

    <TextView
        android:id="@+id/confirmNewBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:textColor="@color/balance_due"
        android:textAppearance="@style/TextAppearance.Fides.Money"
        app:layout_constraintBaseline_toBaselineOf="@id/confirmNewBalanceLabel"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="90,00 TL" />

    <!-- Confirm is primary; cancel is a low-emphasis escape hatch -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:textAppearance="@style/TextAppearance.Fides.Money"
        app:layout_constraintBottom_toTopOf="@id/btnCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="@dimen/space_3"
        tools:text="@string/confirm_write_debt" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/confirm_cancel"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
