<?xml version="1.0" encoding="utf-8"?>
<!-- One ledger entry: description + timestamp on the left, signed amount right.

     Tappable: it opens what the entry was made of. The ripple is what says so — without a
     background the row would react to a touch with nothing at all, and a list that
     navigates invisibly is one people do not discover. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/row_vertical">

    <TextView
        android:id="@+id/txDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@id/txAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Ekmek, süt" />

    <TextView
        android:id="@+id/txDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/txAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txDescription"
        tools:text="20.07.2026 09:15" />

    <TextView
        android:id="@+id/txAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Fides.Money"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="+50,00 TL" />

</androidx.constraintlayout.widget.ConstraintLayout>
