<?xml version="1.0" encoding="utf-8"?>
<!--
  The T-Fides mark as an adaptive-icon foreground.

  Inset by 22% on every side: an adaptive icon's 108dp canvas only guarantees the
  middle 72dp is visible, because launchers mask the rest into whatever shape they
  use. A logo drawn to the edges gets its corners eaten on a circular mask.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/logo_fides"
    android:insetBottom="22%"
    android:insetLeft="22%"
    android:insetRight="22%"
    android:insetTop="22%" />
