<?xml version="1.0" encoding="utf-8"?>
<!--
  The brand stripe down the left edge of a focus card.

  Full brand at the top, spent to near-transparent at the bottom. A solid stripe drew a
  hard vertical rule that cut the card in two; fading it means the eye reads it as where
  the card begins rather than as a border.

  DELIBERATELY SQUARE. The card clips it (android:clipToOutline on the wrapper), so the
  stripe is cut to the card's own 14dp curve and follows it exactly — the same thing
  `overflow: hidden` does in the HTML draft this theme came from.

  Rounding the stripe itself was the previous attempt and it was wrong: two curves of
  different radii sat side by side, and at 4dp wide the corners ate most of the stripe.
  Let the container do the shaping and the stripe only has to be a gradient.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:startColor="@color/stripe_top"
        android:endColor="@color/stripe_bottom"
        android:type="linear" />
</shape>
