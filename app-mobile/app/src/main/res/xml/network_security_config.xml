<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted for the local contract mock ONLY.

  Deliberately NOT android:usesCleartextTraffic="true" in the manifest: that flag is
  app-wide and would ship in the release build, silently allowing an unencrypted
  connection to any host — including a downgraded production API. Listing the two
  development hosts keeps the exception to the machine running Prism.

  10.0.2.2 is how the emulator reaches the host; 127.0.0.1/localhost cover a device
  running the mock behind an adb reverse tunnel. Everything else, in every build type,
  still requires TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
