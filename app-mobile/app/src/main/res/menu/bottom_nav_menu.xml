<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard tabs. Each item id matches a destination id in dashboard_graph.xml,
     which lets setupWithNavController wire them up automatically. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/debtsFragment"
        android:icon="@drawable/ic_debts"
        android:title="@string/nav_debts" />

    <!--
      Insights, for buyers too (Turn 46). The destination has always been in
      dashboard_graph.xml, but this item was only in the seller menu — so a pure buyer had
      no way to reach a screen that has a whole half written for them.

      Third position, matching where it sits in the seller menu, so the tab does not move
      under someone who becomes a seller.
    -->
    <item
        android:id="@+id/reportsFragment"
        android:icon="@drawable/ic_reports"
        android:title="@string/nav_reports" />

    <item
        android:id="@+id/approvalsFragment"
        android:icon="@drawable/ic_approvals"
        android:title="@string/nav_approvals" />

    <item
        android:id="@+id/profileFragment"
        android:icon="@drawable/ic_profile"
        android:title="@string/nav_profile" />

</menu>
