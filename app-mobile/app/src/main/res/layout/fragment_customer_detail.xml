<?xml version="1.0" encoding="utf-8"?>
<!--
  One customer's account in this seller's book.

  A FOCUS CARD screen (theme B-a): the balance sits on its own gradient panel with a
  brand stripe down the left edge and a sparkline beneath it. Four screens in the app
  get this treatment; the rest stay plain, because a stripe on everything stops being
  emphasis.

  Every id here is unchanged from the previous layout. The fragment and view model were
  not touched, except where detailBalance became a MoneyText — see the header comment on
  that class for why the two number effects had to be sequenced rather than combined.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/detailName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_edge"
        android:layout_marginTop="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.Fides.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Fatma Şahin" />

    <TextView
        android:id="@+id/detailPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_edge"
        android:layout_marginTop="@dimen/space_1"
        android:textAppearance="@style/TextAppearance.Fides.Caption"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailName"
        tools:text="+905556667788" />

    <!--
      The focus card, as a WRAPPER rather than a flat sibling.

      It began as a bare View whose Top was tied to the label, while the label's Start was
      tied back to the card. Neither could be resolved before the other, so the card
      enclosed nothing: the sparkline ran past its right edge and the label sat outside it.
      Containing the children removes the question entirely.

      A ConstraintLayout with a drawable background rather than a MaterialCardView: a card
      view brings an elevation shadow, and on this ground a shadow is a smudge.

      PADDING IS ON THE CHILDREN, not here. The stripe has to touch the card's own edge,
      and padding on this container would push it inward along with everything else.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/balanceCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_edge"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_card_focus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailPhone">

        <!-- The stripe: its own view because a border cannot carry a gradient. Pinned to
             the card's edge with no margin, which is what the missing padding above buys. -->
        <View
            android:id="@+id/balanceStripe"
            android:layout_width="@dimen/stripe_width"
            android:layout_height="0dp"
            android:background="@drawable/bg_card_stripe"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/detailBalanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_5"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/current_balance"
            android:textAppearance="@style/TextAppearance.Fides.Label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
          MoneyText, not TextView: counts up on arrival, then takes a gradient. The id is
          unchanged, so the fragment finds the same field; only its type differs.
        -->
        <com.example.app_mobile.view.MoneyText
            android:id="@+id/detailBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_5"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Fides.Display"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailBalanceLabel"
            tools:text="2.616,00 TL" />

        <!--
          The inflation line: what part of this balance is indexation rather than goods.
          Gone until there is any, so a debt made entirely of goods is not shown a zero.
        -->
        <TextView
            android:id="@+id/detailIndexationNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_5"
            android:layout_marginEnd="@dimen/space_5"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Fides.Caption"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailBalance"
            tools:text="Bunun 66,00 TL'si enflasyon farkı"
            tools:visibility="visible" />

        <com.example.app_mobile.view.SparklineView
            android:id="@+id/balanceSpark"
            android:layout_width="0dp"
            android:layout_height="@dimen/sparkline_height"
            android:layout_marginStart="@dimen/space_5"
            android:layout_marginTop="@dimen/space_3"
            android:layout_marginEnd="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailIndexationNote" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/txFilterGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_edge"
        android:layout_marginTop="@dimen/space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/balanceCard"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTxAll"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/filter_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTxDebt"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_debt" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTxPayment"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_payment" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTxIndexation"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_indexation" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_2"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txFilterGroup"
        tools:itemCount="3"
        tools:listitem="@layout/item_transaction" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detail_empty"
        android:textAppearance="@style/TextAppearance.Fides.Body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/transactionList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/transactionList"
        tools:visibility="visible" />

    <!-- Two write actions: book a veresiye, or take a payment. Both go through
         the approval gate. -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_edge"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_4"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDebt"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/detail_write_debt"
            android:textAppearance="@style/TextAppearance.Fides.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPay"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:text="@string/detail_take_payment"
            android:textAppearance="@style/TextAppearance.Fides.Button" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
