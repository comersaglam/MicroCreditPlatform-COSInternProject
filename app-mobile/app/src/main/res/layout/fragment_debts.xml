<?xml version="1.0" encoding="utf-8"?>
<!--
  What I owe, grouped by shop. The buyer's home screen.

  A FOCUS CARD screen (theme B-a). The card used to be tinted red to state the role at a
  glance; the tint is gone because the figure itself now carries the direction in its
  gradient, and a red panel plus a red number was saying the same thing twice.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      The focus card, as a WRAPPER rather than a flat sibling.

      It began as a bare View whose Top was tied to the label, while the label's Start was
      tied back to the card. Neither could be resolved before the other, so the card
      enclosed nothing: the sparkline ran past its right edge and the label sat outside it.

      PADDING IS ON THE CHILDREN, not here. The stripe has to touch the card's own edge,
      and padding on this container would push it inward along with everything else.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/totalCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_edge"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_card_focus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- The stripe: its own view because a border cannot carry a gradient. -->
        <View
            android:id="@+id/totalStripe"
            android:layout_width="@dimen/stripe_width"
            android:layout_height="0dp"
            android:background="@drawable/bg_card_stripe"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/totalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_5"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/debts_total_label"
            android:textAppearance="@style/TextAppearance.Fides.Label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.example.app_mobile.view.MoneyText
            android:id="@+id/totalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_5"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Fides.Display"
            android:textSize="36sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/totalLabel"
            tools:text="143,64 TL" />

        <com.example.app_mobile.view.SparklineView
            android:id="@+id/totalSpark"
            android:layout_width="0dp"
            android:layout_height="@dimen/sparkline_height"
            android:layout_marginStart="@dimen/space_5"
            android:layout_marginTop="@dimen/space_3"
            android:layout_marginEnd="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/totalAmount" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/debtList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/totalCard"
        tools:itemCount="2"
        tools:listitem="@layout/item_seller_debt" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/debts_empty"
        android:textAppearance="@style/TextAppearance.Fides.Body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/debtList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/debtList"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
