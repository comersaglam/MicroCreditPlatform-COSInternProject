<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <!--
                  Profile completion.

                  ⚠️ FIXED VALUES, deliberately (Turn 47, decision 47.1). Nothing here is
                  read from or written to anywhere — the bar does not move and the fields
                  below take no input. This is a showcase of what profile completion WILL
                  look like, not a working feature, and deferred.md §L.16 says so.

                  A real one needs Room columns with no server copy, which the destructive
                  migration would erase on the next schema bump, plus a preserving write
                  path (@Upsert would otherwise wipe the profile on every sign-in). That is
                  a turn of its own; this one is the picture.
                -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_completion_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/profileCompletionBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progress="83"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="6dp" />

                    <TextView
                        android:id="@+id/profileCompletionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="@string/profile_completion_value"
                        android:textAppearance="@style/TextAppearance.Fides.Body" />
                </LinearLayout>

                <TextView
                    android:id="@+id/profileMissingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/profile_missing_fields"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption" />

                <View style="@style/ProfileDivider" />

                <!-- Name row (editable) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_name_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/displayNameText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Fides.Body"
                        tools:text="Ahmet Yılmaz" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditName"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_edit" />
                </LinearLayout>

                <View style="@style/ProfileDivider" />

                <!-- Phone row (read-only, it is the identity) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_phone_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/phoneText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Fides.Body"
                    tools:text="+90 555 111 22 33" />

                <View style="@style/ProfileDivider" />

                <!-- Email row (editable) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_email_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/emailText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Fides.Body"
                        tools:text="ahmet@example.com" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditEmail"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_edit" />
                </LinearLayout>

                <View style="@style/ProfileDivider" />

                <!--
                  The four KYC rows. Values are STRING CONSTANTS, not bindings — see the
                  completion note above. They follow the same caption/value idiom as every
                  row in this card so that filling them in later is a change of source, not
                  of layout.
                -->

                <!-- TC row. MASKED, and that is not decoration: a full national id number
                     on a screen ends up in the presentation recording, and it would
                     contradict the consent text's promise that it never leaves the device
                     (deferred.md §L.5). -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_tc_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tcText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_tc_masked"
                    android:textAppearance="@style/TextAppearance.Fides.Body" />

                <View style="@style/ProfileDivider" />

                <!-- Birth date row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_birthdate_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/birthDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_birthdate_value"
                    android:textAppearance="@style/TextAppearance.Fides.Body" />

                <View style="@style/ProfileDivider" />

                <!-- Address row: the one deliberately left EMPTY, so the bar has something
                     to be short of. A completion meter at 100% says nothing. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_address_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/addressText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_not_set"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/TextAppearance.Fides.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddAddress"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_add" />
                </LinearLayout>

                <View style="@style/ProfileDivider" />

                <!-- ID photo row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_idphoto_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/idPhotoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_idphoto_added"
                        android:textAppearance="@style/TextAppearance.Fides.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIdPhoto"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_view" />
                </LinearLayout>

                <View style="@style/ProfileDivider" />

                <!-- Roles row (read-only) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_roles_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rolesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Fides.Body"
                    tools:text="Alıcı, Satıcı" />

                <!-- Shop row: seller only (gone until "Satıcı ol"). -->
                <LinearLayout
                    android:id="@+id/shopRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View style="@style/ProfileDivider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/profile_shop_label"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAppearance="@style/TextAppearance.Fides.Caption"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/shopNameText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Fides.Body"
                            tools:text="Ahmet Bakkal" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditShop"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_edit" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBecomeSeller"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/profile_become_seller"
            android:textAppearance="@style/TextAppearance.Fides.Body" />

        <!--
          Partner accounts. Every one of these is a mock (deferred.md §L.3) and the point is
          the ARGUMENT, not the button: a ledger that knows what someone owes and how
          reliably they repay is the input a lender needs, and Yapı Kredi is here to say
          that out loud. Turning a shopkeeper's notebook into a credit history is the whole
          product thesis.

          Each partner is drawn in ITS OWN colours: their ground, their type on top. No
          logo — those are trademarked and we hold no licence to draw them — but the name in
          the brand's own palette is enough for anyone in the room to know who is meant, and
          it reads as somebody else's rail rather than as another of our buttons.

          Placed above the POS pairing card: connecting an account is a bigger claim than
          pairing a till, and the card that carries the microcredit argument should not be
          the last thing before the logout button.
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_partners_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/profile_partners_hint"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Fides.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectTokenflex"
                    style="@style/Widget.Fides.BrandButton"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/partner_tokenflex"
                    android:textColor="@color/brand_tokenflex_fg"
                    app:backgroundTint="@color/brand_tokenflex_bg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectOdero"
                    style="@style/Widget.Fides.BrandButton"
                    android:text="@string/partner_odero"
                    android:textColor="@color/brand_odero_fg"
                    app:backgroundTint="@color/brand_odero_bg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectYapikredi"
                    style="@style/Widget.Fides.BrandButton"
                    android:text="@string/partner_yapikredi"
                    android:textColor="@color/brand_yapikredi_fg"
                    app:backgroundTint="@color/brand_yapikredi_bg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pairing card: seller + not paired. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pairCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_pair_prompt"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="@style/TextAppearance.Fides.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/profile_pair_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Paired confirmation: seller + paired. -->
        <TextView
            android:id="@+id/pairedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:text="@string/profile_paired"
            android:textColor="?attr/colorPrimary"
            android:textAppearance="@style/TextAppearance.Fides.Body"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/profile_logout"
            android:textAppearance="@style/TextAppearance.Fides.Body" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
