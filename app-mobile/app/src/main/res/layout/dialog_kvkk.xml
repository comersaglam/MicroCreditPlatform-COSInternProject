<?xml version="1.0" encoding="utf-8"?>
<!--
  The KVKK notice, as a dialog body.

  Two things have to be true at once and they pull against each other: the notice is long
  on purpose and must be readable to the end, and the checkbox that gates acceptance must
  always be reachable. The scrolling text therefore takes what is LEFT after the checkbox
  has its space, never the other way round.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_5"
    android:paddingTop="@dimen/space_3">

    <!--
      ⚠️ height=0dp with a weight, NOT wrap_content with a maxHeight.

      It was the latter, and the checkbox below it never appeared: android:maxHeight is not
      honoured by ScrollView, so 1500 characters of notice took the whole dialog and pushed
      the checkbox off the bottom of the screen. With the checkbox unreachable the positive
      button stayed permanently disabled — the notice could be cancelled but never accepted.

      A weight of 1 makes the text take what is LEFT after the checkbox has its space, so
      the control the button waits on is always the one guaranteed to be on screen.
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/kvkkText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="@string/kvkk_text"
            android:textAppearance="@style/TextAppearance.Fides.Body" />
    </ScrollView>

    <!--
      The checkbox the positive button waits on. Not pre-checked, and there is no way to
      make it so: a consent that arrives already given is not consent.
    -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/kvkkAcceptCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/kvkk_accept"
        android:textAppearance="@style/TextAppearance.Fides.Caption" />

</LinearLayout>
