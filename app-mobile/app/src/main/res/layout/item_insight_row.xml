<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of a ranked list: a label, a bar as long as its share, and the amount.

  The bar is two weighted Views, not a chart. For a sorted list of six the proportion is
  the whole message, and a Canvas view would be more machinery for less: this way the row
  is a layout, the widths are layout_weight, and there is nothing to draw or invalidate.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rowLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Fides.Body"
            tools:text="Toplu alışveriş" />

        <TextView
            android:id="@+id/rowAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:textAppearance="@style/TextAppearance.Fides.Money"
            tools:text="297.354,00 TL" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/space_1"
        android:orientation="horizontal">

        <View
            android:id="@+id/rowBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/primary" />

        <!-- The remainder. Present so the filled part is a share of the row's width
             rather than of whatever the parent happens to be. -->
        <View
            android:id="@+id/rowBarRest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0" />
    </LinearLayout>

</LinearLayout>
