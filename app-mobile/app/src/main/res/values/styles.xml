<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- A hairline separator between profile card rows. -->
    <style name="ProfileDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!--
      A card that states a money direction with a soft fill and a hairline stroke.
      No elevation: the colour carries the meaning, not a shadow. The corner radius
      matches the approval card so every card in the app reads as one family.

      The .Debt/.Credit variants are for the fixed screen headers; approval cards use
      the base style and set their colours at bind time (they vary per row).
    -->
    <style name="Widget.Appmobile.DirectionCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Appmobile.DirectionCard.Debt">
        <item name="cardBackgroundColor">@color/debt_container</item>
        <item name="strokeColor">@color/debt_stroke</item>
    </style>

    <style name="Widget.Appmobile.DirectionCard.Credit">
        <item name="cardBackgroundColor">@color/credit_container</item>
        <item name="strokeColor">@color/credit_stroke</item>
    </style>

    <!--
      A full-width outlined button, for a route that is OURS.

      It was written for the partner buttons and no longer holds any: those moved to the
      filled brand style below in Turn 47b. What is left on it is "Normal Ödeme" in the
      payment sheet — the one working route — and outlined is exactly right for it. The
      three brands beside it are filled in their own colours; drawing ours the same way
      would put it in company it does not keep.
    -->
    <style name="Widget.Fides.PartnerButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_marginTop">@dimen/space_2</item>
        <!-- Same weight as the filled brand buttons: in the payment sheet the four options
             sit in one list, and a lighter label on one of them would read as the odd one
             out rather than as the deliberate choice it is. -->
        <item name="android:textAppearance">@style/TextAppearance.Fides.Button</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
    </style>

    <!--
      A partner rendered in ITS OWN colours: their ground, their type on top.

      Distinct from the outlined style above, which the payment sheet still uses. There the
      four options have to read as one list of choices, so they share our surface and differ
      only by an accent. Here the point is the opposite — the card exists to say whose rails
      these would be, and a bank drawn in our palette reads as our feature.

      Both styles centre their label. Without an icon, a left-aligned name on a full-width
      button leaves an empty right half that reads as a logo that failed to load.
    -->
    <style name="Widget.Fides.BrandButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_marginTop">@dimen/space_2</item>
        <!--
          The Button appearance, not Body: sans-serif-medium rather than regular. A brand
          name is a mark, and at regular weight on a filled ground it reads as a sentence
          somebody typed onto a button.
        -->
        <item name="android:textAppearance">@style/TextAppearance.Fides.Button</item>
        <!--
          No cornerRadius override. Every other MaterialButton in the app takes Material's
          own fully-rounded shape, and these had been given an 8dp square-ish corner that
          made them the only three buttons on the screen with a different silhouette.
        -->
        <!-- The ripple has to come from the brand's own foreground, or Material tints it
             with our primary and a blue flash crosses a green button. -->
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>
</resources>
