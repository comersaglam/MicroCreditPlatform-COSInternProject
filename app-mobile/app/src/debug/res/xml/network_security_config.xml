<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY override. Living in src/debug means the release build never sees this file and
  keeps the strict main/ version, so nothing listed here can ship.

  Beyond the emulator and loopback hosts, a physical phone reaches the backend by the
  developer machine's LAN address, which changes with the network. That address comes from
  the `mobileApiHost` Gradle property (see app/build.gradle.kts), which generates the
  debug_api_host string resource referenced below — an XML resource cannot take a manifest
  placeholder, but it can point at another resource. So a new DHCP lease is a build flag
  rather than a source edit. It defaults to the emulator alias, repeating a host already
  permitted above.

  Everything else, in every build type, still requires TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host, plus a device on an adb reverse tunnel. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.155.137</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- The developer machine, when the client is a real device on the same Wi-Fi. -->
        <domain includeSubdomains="false">@string/debug_api_host</domain>
    </domain-config>
</network-security-config>
