<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ package visibility: without this, resolving/starting the
         app-pos activity (via setPackage + the CREDIT action) fails silently.
         We declare exactly what we launch. -->
    <queries>
        <package android:name="com.example.app_pos" />
        <intent>
            <action android:name="com.example.app_pos.action.CREDIT" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mockpos">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The name the REAL gateway is addressed by. app-pos starts it as

                com.tokeninc.sardis.paymentgateway/.MainActivity

            which resolves to <applicationId>.MainActivity — and this app's actual class
            lives in com.example.mock_pos, its Kotlin package. An alias bridges the two, so
            app-pos carries the real component name and needs no development-only variant.
            When the real gateway is installed instead, nothing on the app-pos side changes.
        -->
        <activity-alias
            android:name="com.tokeninc.sardis.paymentgateway.MainActivity"
            android:targetActivity=".MainActivity"
            android:exported="true" />
    </application>

</manifest>